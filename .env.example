# Must be an existing absolute directory outside this Git repository when
# running the API directly on the host.
DIARY_DATA_DIR=/absolute/path/to/diary-data
DIARY_TIMEZONE=Asia/Shanghai

# Host path mounted into the Compose api container as /data.
# For quick local testing, the default ./data path is ignored by Git.
DIARY_HOST_DATA_DIR=./data

# UID/GID used by the Compose api container when writing DIARY_HOST_DATA_DIR.
# Set these to the host user that should own diary files. On luessiaw-server:
# id -u luessiaw -> 1000, id -g luessiaw -> 1000.
DIARY_API_UID=1000
DIARY_API_GID=1000

# Minimal single-admin lock-screen password. Change before starting the API.
DIARY_ADMIN_PASSWORD=change-this-before-first-start

# At least 32 characters. Generate a real value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DIARY_SESSION_SECRET=replace-with-a-real-random-secret-at-least-32-chars

# Optional server-side Immich picker. The key file stays outside Git and should
# grant only asset.read, asset.view, asset.download, and album.read.
DIARY_IMMICH_ENABLED=false
DIARY_IMMICH_BASE_URL=http://immich-api:2283/api
DIARY_IMMICH_API_KEY_HOST_FILE=/absolute/path/to/serein-diary/secrets/immich-api-key

# AI-written diary entries (off by default).
#
# An agent that digests conversations may POST to /api/v1/ai/entries. That token can
# create entries and do nothing else: no listing, no reading, no edits, no
# deletes. Only the sha256 digest is stored here, so the plaintext token never
# reaches the server or `docker inspect`.
#
# Issue one on the host:
#   cd backend
#   DIARY_DATA_DIR=... DIARY_ADMIN_PASSWORD=... DIARY_SESSION_SECRET=... \
#     python -m serein.issue_ai_token
# Then put the token into the agent's token file (chmod 600) and the digest here.
DIARY_AI_WRITER_ENABLED=false
# DIARY_AI_TOKEN_SHA256=<64 hex characters from the command above>

# Build stage (optional). Leave both proxy entries unset to build without a
# proxy; use a mirror when the default index is unreachable.
# DIARY_BUILD_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# DIARY_BUILD_PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
# DIARY_BUILD_HTTP_PROXY=http://127.0.0.1:7890
# DIARY_BUILD_HTTPS_PROXY=http://127.0.0.1:7890
