# Must be an existing absolute directory outside this Git repository when
# running the API directly on the host.
DIARY_DATA_DIR=/absolute/path/to/diary-data
DIARY_TIMEZONE=Asia/Shanghai

# Host path mounted into the Compose api container as /data.
# For quick local testing, the default ./data path is ignored by Git.
DIARY_HOST_DATA_DIR=./data

# Minimal single-admin lock-screen password. Change before starting the API.
DIARY_ADMIN_PASSWORD=change-this-before-first-start

# At least 32 characters. Generate a real value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DIARY_SESSION_SECRET=replace-with-a-real-random-secret-at-least-32-chars
